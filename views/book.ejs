<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/output.css">
    <title>Add Home</title>
</head>
<body class="min-h-screen bg-slate-100 text-slate-800">
    <%- include('partials/nav')%>
    <main class="mx-auto max-w-xl px-4 py-10">
        <section class="rounded-xl bg-white p-6 shadow">
            <h1 class="text-2xl font-bold">Add Home</h1>
            <p class="mt-1 text-sm text-slate-600">Fill in the details below.</p>

            <form action="/host/add-home" method="POST" class="mt-6 space-y-4">
                <div>
                    <label for="name" class="mb-1 block text-sm font-medium">Name</label>
                    <input type="text" id="name" name="name" class="w-full rounded-md border border-slate-300 px-3 py-2 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200">
                </div>

                <div>
                    <label for="house-name" class="mb-1 block text-sm font-medium">House Name</label>
                    <input type="text" id="house-name" name="house-name" class="w-full rounded-md border border-slate-300 px-3 py-2 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200">
                </div>

                <div class="flex items-center gap-3 pt-2">
                    <button type="submit" class="rounded-md bg-blue-600 px-5 py-2.5 text-white transition hover:bg-blue-700">Submit</button>
                    <a href="/" class="text-sm font-medium text-blue-600 hover:text-blue-700">Back to Home</a>
                </div>
            </form>
        </section>
    </main>
</body>
</html>